# Android Fastlane Configuration

default_platform(:android)

platform :android do
  desc "Push a new beta build to Google Play Internal Testing"
  lane :beta do
    # Increment version code
    increment_version_code(
      gradle_file_path: "app/build.gradle"
    )

    # Build the app
    gradle(
      task: "bundle",
      build_type: "Release"
    )

    # Upload to Google Play Internal Testing
    upload_to_play_store(
      track: "internal",
      aab: lane_context[SharedValues::GRADLE_AAB_OUTPUT_PATH],
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true
    )

    # Post to Slack (optional)
    # slack(
    #   message: "Successfully uploaded FaceIt beta build to Google Play Internal Testing! 🚀",
    #   channel: "#releases"
    # )
  end

  desc "Push a new production build to Google Play"
  lane :release do
    # Ensure we're on main branch
    ensure_git_branch(branch: 'main')

    # Increment version code
    increment_version_code(
      gradle_file_path: "app/build.gradle"
    )

    # Build the app
    gradle(
      task: "bundle",
      build_type: "Release"
    )

    # Upload to Google Play Production
    upload_to_play_store(
      track: "production",
      aab: lane_context[SharedValues::GRADLE_AAB_OUTPUT_PATH],
      skip_upload_metadata: false,
      skip_upload_images: false,
      skip_upload_screenshots: false
    )

    # Commit version bump
    git_commit(
      path: ["android/app/build.gradle"],
      message: "Android version bump by fastlane"
    )

    # Tag release
    add_git_tag
    push_to_git_remote
  end

  desc "Run tests"
  lane :test do
    gradle(
      task: "test"
    )
  end

  desc "Build debug APK"
  lane :dev do
    gradle(
      task: "assemble",
      build_type: "Debug"
    )
  end

  desc "Build release APK (for distribution outside Play Store)"
  lane :build_apk do
    gradle(
      task: "assemble",
      build_type: "Release"
    )
  end
end
